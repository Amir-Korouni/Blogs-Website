  "info": {
    "title": "Blog API",
    "description": "API documentation for the blog management system",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" }
    },
    "schemas": {
      "UpdateUserModels": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "New username",
            "example": "amir_mmd",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "description": "New email address",
            "example": "amir@example.com",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "description": "New password",
            "example": "NewStrongPassword123!",
            "minLength": 8,
            "maxLength": 255
          },
          "avatarMediaId": {
            "type": "number",
            "description": "ID of the new avatar media",
            "example": 1,
            "minimum": 1
          }
        }
      },
      "CreateUserModels": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username of the user",
            "example": "amir_mmd",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "amir@example.com",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "StrongPassword123!",
            "minLength": 8,
            "maxLength": 255
          }
        },
        "required": ["username", "email", "password"]
      },
      "LoginAuthModels": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "user@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "StrongPassword123!",
            "minLength": 1
          }
        },
        "required": ["email", "password"]
      },
      "ChangePasswordModels": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "Current password",
            "example": "CurrentPassword123!",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "description": "New password",
            "example": "NewPassword123!",
            "minLength": 8,
            "maxLength": 255
          },
          "confirmPassword": {
            "type": "string",
            "description": "Confirm new password",
            "example": "NewPassword123!",
            "minLength": 1
          }
        },
        "required": ["currentPassword", "newPassword", "confirmPassword"]
      },
      "CreatePostModels": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title",
            "example": "Getting Started with NestJS",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "description": "Post content",
            "example": "NestJS is a progressive Node.js framework..."
          },
          "excerpt": {
            "type": "string",
            "description": "Short summary of the post",
            "example": "An introduction to NestJS and its main features."
          },
          "status": {
            "type": "string",
            "description": "Post publication status",
            "enum": ["draft", "published"],
            "example": "draft"
          },
          "categoryId": {
            "type": "number",
            "description": "ID of the post category",
            "example": 1,
            "minimum": 1
          },
          "tagIds": {
            "description": "List of tag IDs associated with the post",
            "example": [1, 2, 3],
            "type": "array",
            "items": { "type": "number" }
          },
          "coverMediaId": {
            "type": "number",
            "description": "ID of the cover media",
            "example": 1,
            "minimum": 1
          }
        },
        "required": ["title", "content", "excerpt", "categoryId"]
      },
      "UpdatePostModels": { "type": "object", "properties": {} },
      "CreateCategoryModels": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Category name",
            "example": "Programming",
            "maxLength": 100
          }
        },
        "required": ["name"]
      },
      "UpdateCategoryModels": { "type": "object", "properties": {} },
      "CreateTagModels": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tag name",
            "example": "NestJS",
            "maxLength": 100
          }
        },
        "required": ["name"]
      },
      "UpdateTagModels": { "type": "object", "properties": {} },
      "CreateBlockModel": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of the block",
            "enum": ["text", "heading", "image", "code", "quote"],
            "example": "text"
          },
          "content": {
            "type": "string",
            "description": "Block content",
            "example": "This is a sample paragraph."
          },
          "position": {
            "type": "number",
            "description": "Position of the block",
            "example": 0,
            "minimum": 0
          },
          "mediaId": {
            "type": "object",
            "description": "Associated media ID",
            "example": 1,
            "minimum": 1,
            "nullable": true
          }
        },
        "required": ["type", "content", "position"]
      }
    }
  }
}

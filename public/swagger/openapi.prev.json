      "get": {
        "description": "Retrieves published posts with search, filtering and sorting options.",
        "operationId": "PostsController_getPosts",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search posts by title or content",
            "schema": {
              "maxLength": 100,
              "example": "NestJS",
              "type": "string"
            }
          },
          {
            "name": "categoryId",
            "required": false,
            "in": "query",
            "description": "Filter posts by category ID",
            "schema": { "minimum": 1, "example": 1, "type": "number" }
          },
          {
            "name": "authorId",
            "required": false,
            "in": "query",
            "description": "Filter posts by author ID",
            "schema": { "minimum": 1, "example": 1, "type": "number" }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter posts by publication status",
            "schema": {
              "example": "published",
              "type": "string",
              "enum": ["draft", "published"]
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Field used to sort posts",
            "schema": {
              "example": "createdAt",
              "type": "string",
              "enum": ["createdAt", "updatedAt", "title"]
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "description": "Sorting direction",
            "schema": {
              "example": "DESC",
              "type": "string",
              "enum": ["ASC", "DESC"]
            }
          },
          {
            "description": "Search posts by title or content",
            "required": false,
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "example": "NestJS",
              "type": "string"
            }
          },
          {
            "description": "Filter posts by category ID",
            "required": false,
            "name": "categoryId",
            "in": "query",
            "schema": { "minimum": 1, "example": 1, "type": "number" }
          },
          {
            "description": "Filter posts by author ID",
            "required": false,
            "name": "authorId",
            "in": "query",
            "schema": { "minimum": 1, "example": 1, "type": "number" }
          },
          {
            "description": "Filter posts by publication status",
            "required": false,
            "name": "status",
            "in": "query",
            "schema": {
              "example": "published",
              "type": "string",
              "enum": ["draft", "published"]
            }
          },
          {
            "description": "Field used to sort posts",
            "required": false,
            "name": "sortBy",
            "in": "query",
            "schema": {
              "example": "createdAt",
              "type": "string",
              "enum": ["createdAt", "updatedAt", "title"]
            }
          },
          {
            "description": "Sorting direction",
            "required": false,
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "example": "DESC",
              "type": "string",
              "enum": ["ASC", "DESC"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Posts retrieved successfully." },
          "400": { "description": "Invalid query parameters." }
        },
        "summary": "Get all published posts",
        "tags": ["Posts"]
      }
